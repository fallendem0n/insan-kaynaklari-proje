# Auto detect text files and perform LF normalization
* text=auto

# Language detection overrides
# Mark these as vendored so they don't count towards language stats
*.html linguist-vendored
*.css linguist-vendored
*.js linguist-vendored
*.tex linguist-vendored
*.json linguist-vendored
*.xml linguist-vendored
*.svg linguist-vendored
*.spec linguist-vendored

# Force Python detection
*.py linguist-detectable=true
*.py linguist-language=Python

# Ignore build artifacts and external tools from stats
build/ linguist-vendored
dist/ linguist-vendored
FORDOTOSANIK/build/ linguist-vendored
FORDOTOSANIK/dist/ linguist-vendored
FORDOTOSANIK/poppler/ linguist-vendored
FORDOTOSANIK/tesseract/ linguist-vendored
FORDOTOSANIK/templates/ linguist-vendored
